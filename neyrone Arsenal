local ControlSection = Page:Section({
    Name = "Controls",
    Side = 2
})

ControlSection:Button({
    Name = "Load ESP",
    Callback = function()
        if not EspInterface._hasLoaded then
            EspInterface.Load()
            Library:Notification("ESP Loaded", 3, Color3.fromRGB(0, 255, 100))
        else
            Library:Notification("ESP already loaded", 3, Color3.fromRGB(255, 170, 0))
        end
    end
})

ControlSection:Button({
    Name = "Unload ESP",
    Risky = true,
    Callback = function()
        if EspInterface._hasLoaded then
            EspInterface.Unload()
            Library:Notification("ESP Unloaded", 3, Color3.fromRGB(255, 50, 50))
        else
            Library:Notification("ESP not loaded", 3, Color3.fromRGB(255, 170, 0))
        end
    end
})

Library:Watermark("ESP Script | Loaded")
