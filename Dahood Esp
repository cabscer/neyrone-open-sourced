-- DA HOOD SPECIFIC FUNCTIONS (ENHANCED)
-- ============================================================

function EspInterface.getWeapon(player)
	local character = player.Character
	if not character then return "Fists", nil, nil end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then return "Fists", nil, nil end

	-- Da Hood stores weapons as Tools in the character
	for _, child in ipairs(character:GetChildren()) do
		if child:IsA("Tool") then
			local mag, reserve = getToolAmmo(child)
			local weaponName = child.Name

			-- Fallback to database if no ammo values found
			if not mag then
				local dbEntry = WEAPON_AMMO_DB[weaponName] or WEAPON_AMMO_DB[weaponName:gsub(" ", "")]
				if dbEntry then
					mag = dbEntry.mag
					reserve = dbEntry.reserve
				end
			end

			return weaponName, mag, reserve
		end
	end

	return "Fists", nil, nil
end

function EspInterface.isFriendly(player)
	-- Da Hood does not use Roblox teams for combat.
	-- Everyone is treated as an enemy by default.
	-- If you want to exclude friends, use:
	-- return localPlayer:IsFriendsWith(player.UserId)
	return false
end

function EspInterface.getCharacter(player)
	local character = player.Character
	if not character then return nil, false end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then return nil, false end

	-- Da Hood sometimes uses KO / Dead attributes
	local isKO = character:GetAttribute("KO") == true
	local isDead = humanoid.Health <= 0 or character:GetAttribute("Dead") == true

	return character, humanoid.Health > 0 and not isDead and not isKO
end

function EspInterface.getHealth(player)
	local character = player.Character
	if not character then return 100, 100 end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		return humanoid.Health, humanoid.MaxHealth
	end

	return 100, 100
end

function EspInterface.getArmor(player)
	return getArmorValue(player.Character)
end

function EspInterface.getStatus(player)
	return getPlayerStatus(player.Character)
end

return EspInterface;
