	self.fillsFolder = Instance.new("Folder", self.chamsFolder)
	self.fillsFolder.Name = "fills"

	self.outlinesFolder = Instance.new("Folder", self.chamsFolder)
	self.outlinesFolder.Name = "outlines"

	self.effectsFolder = Instance.new("Folder", self.chamsFolder)
	self.effectsFolder.Name = "effects"

	self.rigs = {
		[0] = {"Head", "Torso", "Left Arm", "Right Arm", "Left Leg", "Right Leg"},
		[1] = {"Head", "UpperTorso", "LowerTorso", "LeftUpperArm", "LeftLowerArm", "LeftHand", "RightUpperArm", "RightLowerArm", "RightHand", "LeftUpperLeg", "LeftLowerLeg", "LeftFoot", "RightUpperLeg", "RightLowerLeg", "RightFoot"}
	}

	self.highlights = {}
	self.effectParticles = {}
	self.initialized = false
	self.lastWeapon = nil

	self.updateConnection = runService.Heartbeat:Connect(function()
		self:Update();
	end);
end

function ChamObject:getRigType()
	if self.player.Character then
		local humanoid = self.player.Character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			return humanoid.RigType == Enum.HumanoidRigType.R15 and 1 or 0
		end
	end
	return 0
end

function ChamObject:loadLimb(limbName)
	if self.player.Character then
		return self.player.Character:FindFirstChild(limbName)
	end
	return nil
end

function ChamObject:makeChams()
	local rigtype = self:getRigType()

	for _, limb in ipairs(self.rigs[rigtype]) do
		local part = self:loadLimb(limb)
		if part and part:IsA("BasePart") then
			-- Fill (inner color)
			local fillHighlight = Instance.new("BoxHandleAdornment", self.fillsFolder)
			fillHighlight.Name = limb .. "_Fill"
			fillHighlight.Size = part.Size + Vector3.new(0.02, 0.02, 0.02)
			fillHighlight.Adornee = part
			fillHighlight.Transparency = 0
			fillHighlight.AlwaysOnTop = true
			fillHighlight.ZIndex = 2

			-- Outline (outer glow)
			local outlineHighlight = Instance.new("BoxHandleAdornment", self.outlinesFolder)
			outlineHighlight.Name = limb .. "_Outline"
			outlineHighlight.Size = part.Size + Vector3.new(0.15, 0.15, 0.15)
			outlineHighlight.Adornee = part
			outlineHighlight.Transparency = 0.1
			outlineHighlight.AlwaysOnTop = false
			outlineHighlight.ZIndex = 1

			self.highlights[limb] = {fill = fillHighlight, outline = outlineHighlight, part = part}
		end
	end
end

function ChamObject:makeElectricEffect()
	-- Create electric spark particles for tasered effect
	local rigtype = self:getRigType()
	for _, limb in ipairs(self.rigs[rigtype]) do
		local part = self:loadLimb(limb)
		if part and part:IsA("BasePart") then
			local attachment = Instance.new("Attachment", part)
			attachment.Name = "ElectricAttachment"

			local spark = Instance.new("ParticleEmitter", attachment)
			spark.Name = "ElectricSpark"
			spark.Texture = "rbxassetid://258128463" -- electric spark texture
			spark.Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.new(0.8, 0.9, 1))
			spark.Size = NumberSequence.new(0.5, 0.1)
			spark.Transparency = NumberSequence.new(0, 1)
			spark.Lifetime = NumberRange.new(0.1, 0.3)
			spark.Rate = 50
			spark.Speed = NumberRange.new(2, 5)
			spark.SpreadAngle = Vector2.new(180, 180)
			spark.Acceleration = Vector3.new(0, 5, 0)
			spark.LightEmission = 1
			spark.LightInfluence = 0

			self.effectParticles[limb] = {attachment = attachment, spark = spark}
		end
	end
end

function ChamObject:clearEffects()
	for limb, effect in pairs(self.effectParticles) do
		if effect.attachment then
			effect.attachment:Destroy()
		end
	end
	self.effectParticles = {}
end

function ChamObject:Update()
	local interface = self.interface
	local options = interface.teamSettings[interface.isFriendly(self.player) and "friendly" or "enemy"]
	local character, alive = interface.getCharacter(self.player)
	local enabled = options.enabled and options.chams and character and alive and not
		(#interface.whitelist > 0 and not find(interface.whitelist, self.player.UserId))
	local isPriority = (interface.sharedSettings.showPriorities and find(interface.priorities, self.player.UserId)) and true or false
	local status = interface.getStatus(self.player)
	local weapon = interface.getWeapon(self.player)

	-- Initialize chams if needed
	if enabled and not self.initialized then
		self:makeChams()
		self.initialized = true
	end

	-- Handle effects based on status
	if enabled and status == "tasered" and not self.hasElectricEffect then
		self:makeElectricEffect()
		self.hasElectricEffect = true
	elseif (not enabled or status ~= "tasered") and self.hasElectricEffect then
		self:clearEffects()
		self.hasElectricEffect = false
	end

	if self.initialized then
		local isEnemy = not interface.isFriendly(self.player)

		-- Determine colors based on status and settings
		local fillColor, outlineColor, fillTrans, outlineTrans

		if status == "tasered" then
			-- White/transparent electric style (image 2)
			fillColor = Color3.new(1, 1, 1)
			outlineColor = Color3.new(0.9, 0.95, 1)
			fillTrans = 0.7
			outlineTrans = 0.3
		elseif status == "knocked" then
			-- Darker/red when knocked
			fillColor = Color3.new(0.3, 0, 0)
			outlineColor = Color3.new(0.5, 0, 0)
			fillTrans = 0.5
			outlineTrans = 0.2
		else
			-- Normal enemy chams (image 1 style - red fill, pink outline)
			if isEnemy then
				fillColor = (interface.sharedSettings.showPriorities and isPriority) and interface.sharedSettings.prioritiesColor or options.chamsFillColor[1]
				outlineColor = options.chamsOutlineColor[1]
				fillTrans = options.chamsFillColor[2]
				outlineTrans = options.chamsOutlineColor[2]
			else
				fillColor = options.chamsFillColor[1]
				outlineColor = options.chamsOutlineColor[1]
				fillTrans = options.chamsFillColor[2]
				outlineTrans = options.chamsOutlineColor[2]
			end
		end

		for limb, highlights in pairs(self.highlights) do
			local part = self:loadLimb(limb)

			if enabled and isEnemy and part then
				-- Update adornments
				highlights.fill.Adornee = part
				highlights.fill.Color3 = fillColor
				highlights.fill.Transparency = fillTrans

				highlights.outline.Adornee = part
				highlights.outline.Color3 = outlineColor
				highlights.outline.Transparency = outlineTrans

				-- Update size in case character changed
				highlights.fill.Size = part.Size + Vector3.new(0.02, 0.02, 0.02)
				highlights.outline.Size = part.Size + Vector3.new(0.15, 0.15, 0.15)
			else
				highlights.fill.Adornee = nil
				highlights.outline.Adornee = nil
			end
		end

		-- Update weapon tag billboard if enabled
		if options.chamsWeaponTag and weapon ~= self.lastWeapon then
			self.lastWeapon = weapon
			-- Could add billboard gui here for weapon name above head
		end
	end
end

function ChamObject:Destruct()
	self.updateConnection:Disconnect()
	self:clearEffects()
	if self.chamsFolder then
		self.chamsFolder:Destroy()
	end
	clear(self)
end

-- instance class
local InstanceObject = {};
InstanceObject.__index = InstanceObject;

function InstanceObject.new(instance, options)
	local self = setmetatable({}, InstanceObject);
	self.instance = assert(instance, "Missing argument #1 (Instance Expected)");
	self.options = assert(options, "Missing argument #2 (table expected)");
	self:Construct();
	return self;
end

function InstanceObject:Construct()
	local options = self.options;
	options.enabled = options.enabled == nil and true or options.enabled;
	options.text = options.text or "{name}";
	options.textColor = options.textColor or { Color3.new(1,1,1), 1 };
	options.textOutline = options.textOutline == nil and true or options.textOutline;
	options.textOutlineColor = options.textOutlineColor or Color3.new();
	options.textSize = options.textSize or 13;
	options.textFont = options.textFont or 2;
	options.limitDistance = options.limitDistance or false;
	options.maxDistance = options.maxDistance or 150;

	self.text = Drawing.new("Text");
	self.text.Center = true;

	self.renderConnection = runService.Heartbeat:Connect(function(deltaTime)
		self:Render(deltaTime);
	end);
end

function InstanceObject:Destruct()
	self.renderConnection:Disconnect();
	self.text:Remove();
end

function InstanceObject:Render()
	local instance = self.instance;
	if not instance or not instance.Parent then
		return self:Destruct();
	end

	local text = self.text;
	local options = self.options;
	if not options.enabled then
		text.Visible = false;
		return;
	end

	local world = getPivot(instance).Position;
	local position, visible, depth = worldToScreen(world);
	if options.limitDistance and depth > options.maxDistance then
		visible = false;
	end

	text.Visible = visible;
	if text.Visible then
		text.Position = position;
		text.Color = options.textColor[1];
		text.Transparency = options.textColor[2];
		text.Outline = options.textOutline;
		text.OutlineColor = options.textOutlineColor;
		text.Size = options.textSize;
		text.Font = options.textFont;
		text.Text = options.text
			:gsub("{name}", instance.Name)
			:gsub("{distance}", round(depth))
			:gsub("{position}", tostring(world));
	end
end

