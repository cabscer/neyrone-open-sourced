local function getToolAmmo(tool)
	if not tool then return nil, nil end

	local mag, reserve = nil, nil

	-- Check for common ammo value names
	local ammoVal = tool:FindFirstChild("Ammo") or tool:FindFirstChild("ammo") or tool:FindFirstChild("CurrentAmmo")
	local maxAmmoVal = tool:FindFirstChild("MaxAmmo") or tool:FindFirstChild("maxAmmo") or tool:FindFirstChild("MaxAmmo")
	local storedVal = tool:FindFirstChild("StoredAmmo") or tool:FindFirstChild("stored") or tool:FindFirstChild("Reserve")

	if ammoVal and ammoVal:IsA("NumberValue") then
		mag = ammoVal.Value
	elseif ammoVal and ammoVal:IsA("IntValue") then
		mag = ammoVal.Value
	end

	if storedVal and storedVal:IsA("NumberValue") then
		reserve = storedVal.Value
	elseif storedVal and storedVal:IsA("IntValue") then
		reserve = storedVal.Value
	end

	-- If no stored ammo but max ammo exists, estimate reserve
	if not reserve and maxAmmoVal then
		local maxAmmo = maxAmmoVal:IsA("NumberValue") and maxAmmoVal.Value or (maxAmmoVal:IsA("IntValue") and maxAmmoVal.Value or nil)
		if maxAmmo and mag then
			reserve = maxAmmo * 3 -- common Da Hood reserve multiplier
		end
	end

	return mag, reserve
end

local function getPlayerStatus(character)
	if not character then return "normal" end

	-- Check for tasered/electric effect (white body)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		-- Check if humanoid has electric status
		if humanoid:GetAttribute("Tased") or humanoid:GetAttribute("Stunned") then
			return "tasered"
		end
		if humanoid:GetAttribute("Knocked") or humanoid:GetAttribute("KO") then
			return "knocked"
		end
		if humanoid.WalkSpeed and humanoid.WalkSpeed < 4 then
			return "slowed"
		end
	end

	-- Check for body effects that indicate electric status
	local bodyEffects = character:FindFirstChild("BodyEffects")
	if bodyEffects then
		local defense = bodyEffects:FindFirstChild("Defense")
		if defense and defense.Value == true then
			return "defense"
		end
		local armor = bodyEffects:FindFirstChild("Armor")
		if armor and armor.Value > 0 then
			return "armored"
		end
	end

	-- Check for grab/knocked
	local KO = character:FindFirstChild("KO")
	if KO and (KO.Value == true or KO:GetAttribute("Value") == true) then
		return "knocked"
	end

	return "normal"
end

local function getArmorValue(character)
	if not character then return 0 end
	local bodyEffects = character:FindFirstChild("BodyEffects")
	if bodyEffects then
		local armor = bodyEffects:FindFirstChild("Armor")
		if armor then
			return armor:IsA("NumberValue") and armor.Value or (armor:IsA("IntValue") and armor.Value or 0)
		end
	end
	return 0
end

