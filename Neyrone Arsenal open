local function getTarget(useFov, fovValue, hitscan)
    local closest = math.huge
    local target = nil
    local targetPart = nil
    local scanParts = {}

    if hitscan == "Head" then
        scanParts = {"Head"}
    elseif hitscan == "Torso" then
        scanParts = {"HumanoidRootPart", "Torso", "UpperTorso"}
    elseif type(hitscan) == "table" then
        scanParts = hitscan
    else
        scanParts = {"Head"}
    end

    local mousePos = userInputService:GetMouseLocation()
    local fovRadius = (camera.ViewportSize.X * ((fovValue / 2) / camera.FieldOfView)) / 2

    for _, player in next, players:GetPlayers() do
        if player == localPlayer or not isAlive(player) then continue end
        if isFriendly(player) then continue end

        local character = player.Character
        local part = nil
        for _, partName in next, scanParts do
            part = character:FindFirstChild(partName)
            if part then break end
        end
        if not part then continue end

        local screenPos, onScreen = camera:WorldToViewportPoint(part.Position)
        if not onScreen then continue end

        local distance = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
        if useFov and distance > fovRadius then continue end

        if distance < closest then
            closest = distance
            target = player
            targetPart = part
        end
    end

    return target, targetPart
end

