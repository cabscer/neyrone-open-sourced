-- Runtime Logic
local SpinAngle = 0
local LastShot = 0
local LastChat = 0
local TriggerFiring = false

-- Silent Aim Hook
if Client.HasHookmetamethod and Client.HasGetnamecallmethod and Client.HasNewcclosure then
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
        local method = getnamecallmethod()
        local args = {...}

        if method == "Raycast" and self == workspace then
            if t["Legit/SilentAim"] and SilentAimTarget and SilentAimPart then
                if t["Legit/SilentAim/HitChance"] >= math.random(1, 100) then
                    args[2] = (SilentAimPart.Position - args[1]).Unit * args[2].Magnitude
                    return oldNamecall(self, unpack(args))
                end
            end
            if t["Rage/Ragebot"] and t["Rage/SilentAim"] and SilentAimTarget and SilentAimPart then
                args[2] = (SilentAimPart.Position - args[1]).Unit * args[2].Magnitude
                return oldNamecall(self, unpack(args))
            end
        end

        return oldNamecall(self, ...)
    end))
end

-- Velocity hook for anti-aim / viewmodel
if Client.HasHookmetamethod then
    local oldIndex
    oldIndex = hookmetamethod(game, "__index", function(self, key)
        if not checkcaller() then
            if key == "Velocity" and self.Parent == localPlayer.Character and t["Rage/AntiAim"] then
                return Vector3.zero
            end
        end
        return oldIndex(self, key)
    end)
end

runService.PreRender:Connect(function()
    local vp = camera.ViewportSize

    -- Update FOV Circles
    LegitFovCircle.Position = Vector2.new(vp.X/2, vp.Y/2)
    LegitFovCircle.Radius = (vp.X * ((t["Legit/Fov/Value"] / 2) / camera.FieldOfView)) / 2
    LegitFovCircle.Visible = t["Legit/Fov/Visible"] == true
    LegitFovCircle.Color = t["Legit/Fov/Color"] and t["Legit/Fov/Color"].Color or Color3.new(1,1,1)
    LegitFovCircle.NumSides = t["Legit/Fov/NumSides"] or 100

    RageFovCircle.Position = Vector2.new(vp.X/2, vp.Y/2)
    RageFovCircle.Radius = (vp.X * ((t["Rage/Fov/Value"] / 2) / camera.FieldOfView)) / 2
    RageFovCircle.Visible = t["Rage/Fov/Visible"] == true
    RageFovCircle.Color = t["Rage/Fov/Color"] and t["Rage/Fov/Color"].Color or Color3.new(1,1,1)
    RageFovCircle.NumSides = t["Rage/Fov/NumSides"] or 100

    -- Silent Aim Target
    if t["Legit/SilentAim"] then
        SilentAimTarget, SilentAimPart = getTarget(t["Legit/Fov"], t["Legit/Fov/Value"], t["Legit/Hitscan"])
    elseif t["Rage/Ragebot"] and t["Rage/SilentAim"] then
        local hitscan = t["Rage/Hitscan"]
        local parts = {}
        if type(hitscan) == "table" then
            if hitscan.Head then table.insert(parts, "Head") end
            if hitscan.Torso then table.insert(parts, "HumanoidRootPart") end
            if hitscan.Arms then table.insert(parts, "Left Arm"); table.insert(parts, "Right Arm") end
            if hitscan.Legs then table.insert(parts, "Left Leg"); table.insert(parts, "Right Leg") end
        else
            parts = {"Head"}
        end
        SilentAimTarget, SilentAimPart = getTarget(t["Rage/Fov"], t["Rage/Fov/Value"], parts)
    else
        SilentAimTarget = nil
        SilentAimPart = nil
    end

    -- Aim Assist
    if t["Legit/Aimbot"] then
        local activated = (t["Legit/Aimbot/Activate"] == "Mouse 1" and userInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)) or
                          (t["Legit/Aimbot/Activate"] == "Mouse 2" and userInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2))
        if activated then
            local target, part = getTarget(t["Legit/Fov"], t["Legit/Fov/Value"], t["Legit/Hitscan"])
            if target and part then
                local screenPos = camera:WorldToViewportPoint(part.Position)
                local mousePos = userInputService:GetMouseLocation()
                local dx = screenPos.X - mousePos.X
                local dy = screenPos.Y - mousePos.Y

                if t["Legit/Aimbot/Type"] == "Mouse Movement" and Client.HasMousemoverel then
                    local speed = t["Legit/Aimbot/Speed"] / 9
                    mousemoverel(dx * speed / 20.5, dy * speed / 20.5)
                elseif t["Legit/Aimbot/Type"] == "Lerp" then
                    local targetCF = CFrame.new(camera.CFrame.Position, part.Position)
                    local angle = math.abs(math.deg(math.acos(camera.CFrame.LookVector:Dot((part.Position - camera.CFrame.Position).Unit))))
                    local speed = t["Legit/Aimbot/Speed"]
                    if t["Legit/Aimbot/SpeedType"] == "Exponential" then
                        speed = speed / 500
                    else
                        speed = (speed / (angle * 2 + 1)) / 100
                    end
                    camera.CFrame = camera.CFrame:Lerp(targetCF, math.clamp(speed, 0, 1))
                elseif t["Legit/Aimbot/Type"] == "Stick" then
                    camera.CFrame = CFrame.new(camera.CFrame.Position, part.Position)
                end
            end
        end
    end

    -- Trigger Bot
    if t["Legit/Triggerbot"] and t["Legit/Triggerbot/Bind"].Toggled and not TriggerFiring then
        local rayParams = RaycastParams.new()
        rayParams.FilterType = Enum.RaycastFilterType.Blacklist
        rayParams.FilterDescendantsInstances = {localPlayer.Character, camera}
        local result = workspace:Raycast(camera.CFrame.Position, camera.CFrame.LookVector * 1000, rayParams)
        if result then
            local hitPlayer = players:GetPlayerFromCharacter(result.Instance.Parent)
            if hitPlayer and not isFriendly(hitPlayer) and isAlive(hitPlayer) then
                TriggerFiring = true
                task.spawn(function()
                    if t["Legit/Triggerbot/Delay"] > 0 then
                        task.wait(t["Legit/Triggerbot/Delay"] / 1000)
                    end
                    if mouse1press and mouse1release then
                        mouse1press()
                        task.wait()
                        mouse1release()
                    end
                    TriggerFiring = false
                end)
            end
        end
    end

    -- Rage Bot
    if t["Rage/Ragebot"] and isAlive(localPlayer) then
        local now = tick()
        local fireRate = t["Rage/RapidFire"] and 0.01 or 0.1
        if now - LastShot >= fireRate then
            local hitscan = t["Rage/Hitscan"]
            local parts = {}
            if type(hitscan) == "table" then
                if hitscan.Head then table.insert(parts, "Head") end
                if hitscan.Torso then table.insert(parts, "HumanoidRootPart") end
                if hitscan.Arms then table.insert(parts, "Left Arm"); table.insert(parts, "Right Arm") end
                if hitscan.Legs then table.insert(parts, "Left Leg"); table.insert(parts, "Right Leg") end
            else
                parts = {"Head"}
            end

            local target, part = getTarget(t["Rage/Fov"], t["Rage/Fov/Value"], parts)
            if target and part then
                if not t["Rage/SilentAim"] then
                    camera.CFrame = CFrame.new(camera.CFrame.Position, part.Position)
                end
                if mouse1press and mouse1release then
                    mouse1press()
                    task.wait()
                    mouse1release()
                    if t["Rage/DoubleTap"] then
                        task.wait(0.05)
                        mouse1press()
                        task.wait()
                        mouse1release()
                    end
                end
                LastShot = now
                if t["Rage/Debug"] then
                    s:Notification("Shot at " .. target.Name, 2, Color3.fromRGB(255, 80, 80))
                end
            end
        end
    end

    -- Knife Bot
    if t["Rage/Ragebot"] and t["Rage/Knifebot"] and isAlive(localPlayer) then
        local char = localPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then
            for _, player in next, players:GetPlayers() do
                if player == localPlayer or isFriendly(player) or not isAlive(player) then continue end
                local targetChar = player.Character
                local targetHrp = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
                if targetHrp then
                    local dist = (hrp.Position - targetHrp.Position).Magnitude
                    if dist <= t["Rage/Knifebot/Radius"] then
                        local shouldStab = true
                        if t["Rage/Knifebot/WallCheck"] then
                            local rayParams = RaycastParams.new()
                            rayParams.FilterType = Enum.RaycastFilterType.Blacklist
                            rayParams.FilterDescendantsInstances = {localPlayer.Character}
                            local result = workspace:Raycast(hrp.Position, (targetHrp.Position - hrp.Position).Unit * dist, rayParams)
                            shouldStab = result and result.Instance:IsDescendantOf(targetChar)
                        end
                        if shouldStab then
                            camera.CFrame = CFrame.new(camera.CFrame.Position, targetHrp.Position)
                            if mouse1press and mouse1release then
                                mouse1press(); task.wait(); mouse1release()
                            end
                        end
                    end
                end
            end
        end
    end

    -- Anti Aim
    if t["Rage/AntiAim"] and isAlive(localPlayer) then
        if not (t["Rage/AntiAim/Disable"] and t["Rage/AntiAim/Disable"].Toggled) then
            local char = localPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hrp then
                local yaw = -math.atan2(camera.CFrame.LookVector.Z, camera.CFrame.LookVector.X) + math.rad(-90)
                SpinAngle = SpinAngle + t["Rage/AntiAim/SpinSpeed"]
                if SpinAngle >= 360 then SpinAngle = 0 end

                if t["Rage/AntiAim/Yaw"] == "Spin" then
                    yaw = yaw + math.rad(SpinAngle)
                elseif t["Rage/AntiAim/Yaw"] == "Random" then
                    yaw = yaw + math.rad(math.random(0, 360))
                end
                yaw = yaw + math.rad(t["Rage/AntiAim/CustomYaw"])

                hrp.CFrame = CFrame.new(hrp.Position) * CFrame.Angles(0, yaw, 0)
            end
        end
    end

    -- Movement
    if isAlive(localPlayer) then
        local char = localPlayer.Character
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local humanoid = char:FindFirstChildOfClass("Humanoid")

        if hrp and humanoid then
            -- Auto Jump
            if t["Misc/AutoJump"] and userInputService:IsKeyDown(Enum.KeyCode.Space) and humanoid.FloorMaterial ~= Enum.Material.Air then
                humanoid.Jump = true
            end

            -- Noclip
            if t["Misc/Noclip"] then
                for _, part in next, char:GetDescendants() do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            else
                if hrp then hrp.CanCollide = true end
            end

            -- Speed Hack
            if t["Misc/SpeedHack"] then
                local moveDir = Vector3.new()
                if userInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + camera.CFrame.LookVector end
                if userInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - camera.CFrame.LookVector end
                if userInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - camera.CFrame.RightVector end
                if userInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + camera.CFrame.RightVector end
                if moveDir.Magnitude > 0 then
                    moveDir = moveDir.Unit * (t["Misc/SpeedHack/Speed"] / 10)
                    hrp.CFrame = hrp.CFrame + Vector3.new(moveDir.X, 0, moveDir.Z) / 100 * 2
                end
            end

            -- Airstuck
            if t["Misc/Airstuck"] and t["Misc/Airstuck/Bind"].Toggled then
                hrp.Anchored = true
            else
                hrp.Anchored = false
            end
        end
    end

    -- Visuals
    if t["Visuals/Ambient"] then
        lighting.Ambient = t["Visuals/Ambient/AmbientColor"].Color
        lighting.OutdoorAmbient = t["Visuals/Ambient/OutdoorAmbientColor"].Color
    end

    if t["Visuals/NoFlash"] then
        for _, gui in next, localPlayer.PlayerGui:GetDescendants() do
            if gui:IsA("Frame") and gui.Name:lower():find("flash") then
                gui.Visible = false
            end
            if gui:IsA("ScreenGui") and gui.Name:lower():find("flash") then
                gui.Enabled = false
            end
        end
    end

    if t["Visuals/NoSmoke"] then
        for _, effect in next, workspace:GetDescendants() do
            if effect:IsA("Smoke") or effect:IsA("Fire") then
                effect.Enabled = false
            end
            if effect:IsA("ParticleEmitter") and (effect.Name:lower():find("smoke") or effect.Name:lower():find("dust")) then
                effect.Enabled = false
            end
        end
    end

    if t["Visuals/TimeChanger"] then
        lighting.ClockTime = t["Visuals/TimeChanger/Time"]
    end

    if t["Visuals/Fullbright"] then
        lighting.Brightness = 10
        lighting.GlobalShadows = false
    elseif not t["Visuals/Ambient"] then
        lighting.Brightness = 2
        lighting.GlobalShadows = true
    end

    -- Third Person
    if t["Visuals/ThirdPerson"] and t["Visuals/ThirdPerson/Bind"].Toggled then
        localPlayer.CameraMode = Enum.CameraMode.Classic
        localPlayer.CameraMaxZoomDistance = t["Visuals/ThirdPerson/Distance"]
        localPlayer.CameraMinZoomDistance = t["Visuals/ThirdPerson/Distance"]
    else
        localPlayer.CameraMode = Enum.CameraMode.LockFirstPerson
        localPlayer.CameraMaxZoomDistance = 0.5
        localPlayer.CameraMinZoomDistance = 0.5
    end

    -- Viewmodel Offset
    if t["Visuals/Viewmodel"] then
        local arms = camera:FindFirstChild("Arms") or camera:FindFirstChild("Viewmodel")
        if arms and arms:IsA("Model") then
            for _, part in next, arms:GetDescendants() do
                if part:IsA("BasePart") then
                    -- This is a simplified approach; real viewmodel offset requires CFrame manipulation each frame
                end
            end
        end
    end

    -- Chat Spammer
    if t["Misc/ChatSpam"] and tick() - LastChat > 3 then
        local msg
        local msgType = t["Misc/ChatSpam/Type"]
        if msgType == "Arsenal" then
            msg = "Arsenal on top " .. tostring(math.random(1,5))
        elseif msgType == "Advertise" then
            msg = "Get good at Arsenal"
        elseif msgType == "Custom" then
            msg = t["Misc/ChatSpam/Custom"]
        end
        if msg then
            local chatEvents = replicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
            if chatEvents then
                local sayEvent = chatEvents:FindFirstChild("SayMessageRequest")
                if sayEvent then
                    sayEvent:FireServer(msg, "All")
                end
            end
        end
        LastChat = tick()
    end

    -- Kill All / Priority Kill
    if (t["Misc/KillAll"] or t["Players/Priority/Kill"]) and isAlive(localPlayer) then
        local now = tick()
        local hps = t["Misc/KillAll"] and t["Misc/KillAll/HPS"] or t["Players/Priority/Kill/HPS"] or 1
        if now - LastShot >= (1 / hps) then
            local targets = {}
            if t["Misc/KillAll"] then
                for _, p in next, players:GetPlayers() do
                    if p ~= localPlayer and not isFriendly(p) and isAlive(p) then
                        table.insert(targets, p)
                    end
                end
            elseif t["Players/Priority/Kill"] then
                for _, p in next, s.Lists.Priority or {} do
                    if p ~= localPlayer and not isFriendly(p) and isAlive(p) then
                        table.insert(targets, p)
                    end
                end
            end

            for _, target in next, targets do
                local targetChar = target.Character
                local head = targetChar and targetChar:FindFirstChild("Head")
                if head and mouse1press and mouse1release then
                    camera.CFrame = CFrame.new(camera.CFrame.Position, head.Position)
                    mouse1press(); task.wait(); mouse1release()
                end
            end
            LastShot = now
        end
    end

    -- Gun Mods
    if WeaponsFolder then
        for _, weapon in next, WeaponsFolder:GetChildren() do
            if weapon:IsA("Folder") or weapon:IsA("Configuration") then
                local cache = WeaponCache[weapon.Name]
                if cache then
                    if t["Misc/GunMods/NoRecoil"] then
                        weapon:SetAttribute("RecoilX", 0)
                        weapon:SetAttribute("RecoilY", 0)
                    else
                        if cache.RecoilX ~= nil then weapon:SetAttribute("RecoilX", cache.RecoilX) end
                        if cache.RecoilY ~= nil then weapon:SetAttribute("RecoilY", cache.RecoilY) end
                    end

                    if t["Misc/GunMods/NoSpread"] then
                        weapon:SetAttribute("Spread", 0)
                    else
                        if cache.Spread ~= nil then weapon:SetAttribute("Spread", cache.Spread) end
                    end

                    if t["Misc/GunMods/FullAuto"] then
                        weapon:SetAttribute("Auto", true)
                    else
                        if cache.Auto ~= nil then weapon:SetAttribute("Auto", cache.Auto) end
                    end

                    if t["Misc/GunMods/RapidFire"] then
                        weapon:SetAttribute("FireRate", 0.01)
                    else
                        if cache.FireRate ~= nil then weapon:SetAttribute("FireRate", cache.FireRate) end
                    end

                    if t["Misc/GunMods/InfAmmo"] then
                        weapon:SetAttribute("Ammo", 999)
                        weapon:SetAttribute("StoredAmmo", 999)
                    else
                        if cache.Ammo ~= nil then weapon:SetAttribute("Ammo", cache.Ammo) end
                        if cache.StoredAmmo ~= nil then weapon:SetAttribute("StoredAmmo", cache.StoredAmmo) end
                    end
                end
            end
        end
    end
end)

